      "prompt_templates": {
        "select_scene_object_v1": {
          "version": "1",
          "template_text": "You are selecting the next object for a perception-guided pick cycle. Use the authoritative backend scene manifest as the primary source of truth for object IDs, poses, shapes, sizes, and spatial semantics. If an image is attached, use it only as auxiliary evidence for attributes that are not already explicit in the manifest. Selection request: `{{ selection_request_text }}`\nAuthoritative scene context JSON: {{ scene_context_json }}\nYou must answer by calling the `select_scene_object` tool. Use the exact candidate object ID when outcome=`selected`. Use an empty string for `selected_object_id` when outcome is `no_match` or `ambiguous`.",
          "variables": {
            "candidate_object_ids": "string_list",
            "scene_context_json": "string",
            "selection_request_text": "string"
          },
          "response_contract": {
            "response_mode": "tool_call",
            "tool_name": "select_scene_object",
            "tool_description": "Choose one candidate object from the current runtime scene context."
          }
        }
