{
  "api_version": "manyforge.program_binding_transport_descriptor.v4",
  "binding_api_version": "manyforge.program_binding.v4",
  "limits": {
    "compiled_text_bytes": 4096,
    "identity_bytes": 128,
    "nested_rows": 4096,
    "node_policy_rows": 100000,
    "provenance_rows": 16384,
    "role_rows": 4096,
    "max_retries": 255
  },
  "scalars": {
    "digest": {
      "kind": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "kind": "string",
      "maximum_utf8_bytes": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "text": {
      "kind": "string",
      "minimum_utf8_bytes": 1,
      "maximum_utf8_bytes": 4096
    }
  },
  "enums": {
    "operator_stop_policy": [
      "inherit",
      "hold",
      "continue"
    ],
    "intervention_stop_scope": [
      "all",
      "own_groups"
    ]
  },
  "records": {
    "binding": [
      "api_version",
      "program_binding_id",
      "program_revision",
      "retained_bundle_id",
      "graph_revision",
      "node_environment",
      "component_bindings",
      "target_bindings",
      "frame_bindings",
      "collision_body_bindings",
      "signal_bindings",
      "node_policies",
      "collision_rule_bodies",
      "provenance",
      "collision_rule_spring_sliders"
    ],
    "node_environment": [
      "catalog_id",
      "content_version",
      "catalog_digest",
      "environment_digest"
    ],
    "component": [
      "component_id",
      "component_type_id",
      "component_type_revision",
      "model_bindings"
    ],
    "model": [
      "model_role_id",
      "model_instance_id",
      "model_revision"
    ],
    "target": [
      "target",
      "frame_references",
      "frame_associations",
      "collision_body_references",
      "signal_references",
      "resource_role_bindings",
      "capability_bindings",
      "pneumatic_io",
      "robot_tcps",
      "default_tcp"
    ],
    "frame": [
      "reference",
      "model_instance_id",
      "model_revision",
      "compiled_frame_name"
    ],
    "tcp_entry": [
      "target",
      "frame"
    ],
    "robot_tcp": [
      "entry",
      "frame",
      "contact_body_role_ids",
      "end_effector",
      "component_default"
    ],
    "resource": [
      "resource_role_id",
      "resource_ids",
      "compiled_resource_names"
    ],
    "collision": [
      "reference",
      "model_instance_id",
      "model_revision",
      "compiled_collision_body_names"
    ],
    "capability": [
      "capability_id",
      "capability_definition_revision",
      "control_binding",
      "capability_provider_binding",
      "command_schema"
    ],
    "node_policy": [
      "instance_id",
      "recovery_policy",
      "operator_stop_policy"
    ],
    "recovery_policy": [
      "allow_intervention",
      "max_retries",
      "intervention_stop_scope"
    ],
    "control": [
      "control_binding_id",
      "control_binding_revision"
    ],
    "provider": [
      "capability_provider_binding_id",
      "capability_provider_binding_revision"
    ],
    "command_schema": [
      "command_schema_id",
      "command_schema_revision"
    ],
    "collision_rule_body": [
      "body",
      "model_role_id",
      "model_instance_id",
      "model_revision",
      "collision_body_ids"
    ],
    "collision_rule_spring_slider": [
      "body",
      "axis",
      "stroke_m",
      "max_compression_step_m"
    ],
    "provenance": [
      "binding_compiler_contract_digest",
      "source_records",
      "resolved_output_records"
    ],
    "provenance_record": [
      "record_kind",
      "record_id",
      "revision"
    ],
    "signal": [
      "reference",
      "target",
      "runtime_unit_id",
      "value_type",
      "direction",
      "transition_capability",
      "signal_descriptor_digest"
    ],
    "pneumatic_io": [
      "outputs",
      "inputs"
    ],
    "pneumatic_output": [
      "signal",
      "open_value",
      "close_value"
    ],
    "pneumatic_input": [
      "input",
      "signal"
    ],
    "target_reference": [
      "component_id",
      "command_target_id"
    ],
    "frame_reference": [
      "component_id",
      "frame_id"
    ],
    "body_reference": [
      "component_id",
      "collision_body_id"
    ],
    "signal_reference": [
      "component_id",
      "signal_name"
    ],
    "frame_association": [
      "frame",
      "contact_body_role_ids"
    ]
  },
  "optional_record_fields": {
    "binding": [
      "collision_rule_spring_sliders"
    ],
    "recovery_policy": [
      "intervention_stop_scope"
    ],
    "target": [
      "pneumatic_io",
      "robot_tcps",
      "default_tcp"
    ]
  },
  "catalog_record_kinds": [
    "model_asset",
    "runtime_profile",
    "component_type",
    "control_interface_contract",
    "controller_topology",
    "provider_manifest",
    "command_schema",
    "capability_definition",
    "stop_evidence_policy"
  ],
  "formulas": {
    "collision_body_id": "component/{controllable_component_id}/model/{model_instance_id}/body/{collision_body_role_id}/collision/{index}"
  },
  "invariants": [
    "closed_records",
    "bounded_scalars",
    "bounded_tables",
    "canonical_sorted_unique",
    "node_policy_enums_and_cross_fields",
    "node_policy_sparse_rows",
    "resource_vector_correspondence",
    "resource_vector_independent_uniqueness",
    "collision_name_uniqueness",
    "capability_has_resolution",
    "direct_reference_correspondence",
    "robot_tcp_entry_frame_correspondence",
    "robot_tcp_sorted_unique",
    "collision_rule_body_model_correspondence",
    "generated_collision_body_ids",
    "spring_slider_rule_body_correspondence",
    "provenance_kind_and_tuple_order"
  ]
}
