{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manyforge.dev/schemas/roboplan-transition-capture-v1.json",
  "title": "ManyForge RoboPlan transition deterministic scene capture",
  "type": "object",
  "required": [
    "schema_version",
    "capture_id",
    "source",
    "robot_model_authority",
    "start_state",
    "resolved_motion",
    "plan_request",
    "planning_result",
    "planner_contract",
    "scene",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "manyforge.roboplan_transition_capture.v1"
    },
    "capture_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": [
        "program",
        "program_sha256",
        "deployment",
        "deployment_sha256",
        "program_run_id",
        "planning_execution_id",
        "predecessor_node",
        "move_id",
        "visual_state_diagnostics"
      ],
      "properties": {
        "planning_execution_id": {"type": "integer", "minimum": 1},
        "move_id": {"const": "drop_approach"}
      }
    },
    "robot_model_authority": {
      "type": "object",
      "required": ["canonical_fingerprint", "view_fingerprint"]
    },
    "start_state": {
      "$ref": "#/$defs/captured_start_state"
    },
    "resolved_motion": {
      "type": "object",
      "required": ["type", "pose_goal", "source"],
      "properties": {
        "type": {"const": "pose_goal"},
        "pose_goal": {"$ref": "#/$defs/pose"},
        "source": {
          "type": "object",
          "required": ["target_reference", "offset_reference", "offset_pose"]
        }
      }
    },
    "plan_request": {
      "$ref": "#/$defs/plan_request"
    },
    "planning_result": {
      "type": "object",
      "required": ["scene_revision", "trajectory", "trajectory_sha256"],
      "properties": {
        "scene_revision": {"$ref": "#/$defs/revision"},
        "trajectory": {"$ref": "#/$defs/trajectory"},
        "trajectory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "planner_contract": {
      "type": "object",
      "required": [
        "rng_base_seed",
        "rng_seed",
        "shortcut_rng_seed_argument",
        "planning_attempt_index"
      ],
      "properties": {
        "rng_base_seed": {"type": "integer", "minimum": 0},
        "rng_seed": {"type": "integer", "minimum": 0},
        "shortcut_rng_seed_argument": {"type": "integer"},
        "planning_attempt_index": {"type": "integer", "minimum": 0}
      }
    },
    "scene": {
      "type": "object",
      "required": ["world_frame", "authority", "robot", "objects"],
      "properties": {
        "world_frame": {"type": "string", "minLength": 1},
        "authority": {
          "type": "object",
          "required": [
            "revision",
            "transaction_sequence",
            "scene_admission_epoch",
            "topology_epoch",
            "policy_epoch",
            "configured_collision_policy"
          ],
          "properties": {
            "revision": {"$ref": "#/$defs/revision"},
            "transaction_sequence": {"type": "integer", "minimum": 0},
            "scene_admission_epoch": {"type": "integer", "minimum": 0},
            "topology_epoch": {"type": "integer", "minimum": 0},
            "policy_epoch": {"type": "integer", "minimum": 0},
            "configured_collision_policy": {
              "$ref": "#/$defs/collision_policy"
            }
          }
        },
        "robot": {
          "type": "object",
          "required": [
            "robot_id",
            "base_frame",
            "pose_in_world",
            "collision_projection_seed"
          ],
          "properties": {
            "robot_id": {"type": "string", "minLength": 1},
            "base_frame": {"type": "string", "minLength": 1},
            "pose_in_world": {"$ref": "#/$defs/pose"},
            "collision_projection_seed": {
              "$ref": "#/$defs/collision_projection_seed"
            }
          }
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scene_object"}
        }
      }
    },
    "semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "required": ["revision_id", "content_hash"],
      "properties": {
        "revision_id": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "minLength": 1}
      }
    },
    "pose": {
      "type": "object",
      "required": ["position_m", "orientation_xyzw"],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "orientation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        }
      }
    },
    "robot_state": {
      "type": "object",
      "required": ["joint_names", "positions_rad", "velocities_rad_s"],
      "properties": {
        "joint_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "positions_rad": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        },
        "velocities_rad_s": {
          "type": "array",
          "minItems": 1,
          "items": {"const": 0}
        }
      }
    },
    "trajectory": {
      "type": "object",
      "required": ["joint_names", "waypoints"],
      "properties": {
        "joint_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "waypoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "time_from_start_s",
              "positions_rad",
              "velocities_rad_s"
            ],
            "properties": {
              "time_from_start_s": {"type": "number", "minimum": 0},
              "positions_rad": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "number"}
              },
              "velocities_rad_s": {
                "type": "array",
                "items": {"type": "number"}
              },
              "accelerations_rad_s2": {
                "type": "array",
                "items": {"type": "number"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "collision_projection_seed": {
      "type": "object",
      "required": ["groups", "sha256"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["group_id", "joint_names", "positions_rad", "source"],
            "properties": {
              "group_id": {"type": "string", "minLength": 1},
              "joint_names": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "positions_rad": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "number"}
              },
              "source": {
                "enum": [
                  "exact_plan_request",
                  "fresh_visual_snapshot_gripper"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "captured_start_state": {
      "allOf": [
        {"$ref": "#/$defs/robot_state"},
        {
          "type": "object",
          "required": ["state_source", "provenance"],
          "properties": {
            "state_source": {"const": "exact_plan_request"},
            "provenance": {
              "type": "object",
              "required": [
                "execution_state_source_mode",
                "capture_method",
                "predecessor_move_id"
              ],
              "properties": {
                "execution_state_source_mode": {"const": "commanded_sim"},
                "capture_method": {"const": "planner_qualification_observer"},
                "predecessor_move_id": {"const": "pick_retreat"}
              }
            }
          }
        }
      ]
    },
    "plan_request": {
      "type": "object",
      "required": [
        "robot_id",
        "group_id",
        "move_id",
        "base_frame",
        "tcp_frame",
        "start_state",
        "motion",
        "tolerances",
        "speed_profile",
        "planning_timeout_s",
        "planning_attempt_index",
        "per_joint_dynamics_limits",
        "contact_policy_id",
        "scene_binding"
      ],
      "properties": {
        "robot_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "move_id": {"const": "drop_approach"},
        "base_frame": {"type": "string", "minLength": 1},
        "tcp_frame": {"type": "string", "minLength": 1},
        "start_state": {"$ref": "#/$defs/robot_state"},
        "motion": {
          "type": "object",
          "required": ["type", "pose"],
          "properties": {
            "type": {"const": "pose"},
            "pose": {"$ref": "#/$defs/pose"}
          }
        },
        "tolerances": {
          "type": "object",
          "required": [
            "joint_position_tol_rad",
            "translation_tol_m",
            "rotation_tol_rad"
          ]
        },
        "speed_profile": {
          "type": "object",
          "required": [
            "velocity_scale",
            "acceleration_scale",
            "max_tcp_linear_speed_mps"
          ],
          "properties": {
            "velocity_scale": {"type": "number", "exclusiveMinimum": 0},
            "acceleration_scale": {"type": "number", "exclusiveMinimum": 0},
            "max_tcp_linear_speed_mps": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            }
          }
        },
        "planning_timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "planning_attempt_index": {"type": "integer", "minimum": 0},
        "per_joint_dynamics_limits": {"type": "object"},
        "contact_policy_id": {"type": "string"},
        "scene_binding": {
          "allOf": [
            {"$ref": "#/$defs/revision"},
            {
              "type": "object",
              "required": ["projection_lease_id"],
              "properties": {
                "projection_lease_id": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "collision_pair": {
      "type": "object",
      "required": ["body_a", "body_b"],
      "properties": {
        "body_a": {"type": "string", "minLength": 1},
        "body_b": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "collision_policy": {
      "type": "object",
      "required": [
        "policy_id",
        "revision",
        "allowed_static_static_pairs",
        "allowed_touch_link_pairs",
        "support_contacts",
        "contact_grasps",
        "require_full_diagnostics"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/revision"},
        "allowed_static_static_pairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/collision_pair"}
        },
        "allowed_touch_link_pairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/collision_pair"}
        },
        "support_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pair", "mode"],
            "properties": {
              "pair": {"$ref": "#/$defs/collision_pair"},
              "mode": {
                "enum": [
                  "contact_release",
                  "contact_process",
                  "bounded_penetration"
                ]
              },
              "release_evidence_mode": {
                "enum": ["signed_penetration", "binary_contact"]
              },
              "enforce_max_start_penetration": {"type": "boolean"},
              "max_start_penetration_m": {"type": "number", "minimum": 0},
              "release_tolerance_m": {"type": "number", "minimum": 0},
              "min_release_progress_m": {"type": "number", "minimum": 0},
              "require_separation_by_end": {"type": "boolean"},
              "require_strictly_decreasing_penetration": {"type": "boolean"},
              "allow_recontact": {"type": "boolean"},
              "max_contact_penetration_m": {
                "type": "number",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"mode": {"const": "contact_release"}},
                  "required": ["mode"]
                },
                "then": {
                  "required": [
                    "release_evidence_mode",
                    "enforce_max_start_penetration",
                    "max_start_penetration_m",
                    "release_tolerance_m",
                    "min_release_progress_m",
                    "require_separation_by_end",
                    "require_strictly_decreasing_penetration",
                    "allow_recontact"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {"required": ["release_evidence_mode"]},
                      {"required": ["enforce_max_start_penetration"]},
                      {"required": ["max_start_penetration_m"]},
                      {"required": ["release_tolerance_m"]},
                      {"required": ["min_release_progress_m"]},
                      {"required": ["require_separation_by_end"]},
                      {"required": ["require_strictly_decreasing_penetration"]},
                      {"required": ["allow_recontact"]}
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {"mode": {"const": "bounded_penetration"}},
                  "required": ["mode"]
                },
                "then": {"required": ["max_contact_penetration_m"]},
                "else": {
                  "not": {"required": ["max_contact_penetration_m"]}
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {"const": "contact_release"},
                    "release_evidence_mode": {"const": "binary_contact"}
                  },
                  "required": ["mode", "release_evidence_mode"]
                },
                "then": {
                  "properties": {
                    "enforce_max_start_penetration": {"const": false},
                    "max_start_penetration_m": {"const": 0},
                    "release_tolerance_m": {"const": 0},
                    "min_release_progress_m": {"const": 0},
                    "require_strictly_decreasing_penetration": {"const": false}
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "contact_grasps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy_id",
              "selected_object_id",
              "allowed_robot_links",
              "max_penetration_m",
              "terminal_window_start_fraction"
            ],
            "properties": {
              "policy_id": {"type": "string", "minLength": 1},
              "selected_object_id": {"type": "string", "minLength": 1},
              "allowed_robot_links": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "max_penetration_m": {"type": "number", "minimum": 0},
              "terminal_window_start_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "require_full_diagnostics": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "support_contact": {
      "type": "object",
      "required": ["support_object_id"],
      "properties": {
        "support_object_id": {"type": "string", "minLength": 1},
        "mode": {
          "enum": [
            "contact_release",
            "contact_process",
            "bounded_penetration"
          ],
          "default": "contact_release"
        },
        "release_evidence_mode": {
          "enum": ["signed_penetration", "binary_contact"]
        },
        "enforce_max_start_penetration": {"type": "boolean"},
        "max_start_penetration_m": {"type": "number", "minimum": 0},
        "release_tolerance_m": {"type": "number", "minimum": 0},
        "min_release_progress_m": {"type": "number", "minimum": 0},
        "require_separation_by_end": {"type": "boolean"},
        "require_strictly_decreasing_penetration": {"type": "boolean"},
        "allow_recontact": {"type": "boolean"},
        "max_contact_penetration_m": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {"enum": ["contact_process", "bounded_penetration"]}
            },
            "required": ["mode"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["release_evidence_mode"]},
                {"required": ["enforce_max_start_penetration"]},
                {"required": ["max_start_penetration_m"]},
                {"required": ["release_tolerance_m"]},
                {"required": ["min_release_progress_m"]},
                {"required": ["require_separation_by_end"]},
                {"required": ["require_strictly_decreasing_penetration"]},
                {"required": ["allow_recontact"]}
              ]
            }
          },
          "else": {
            "properties": {
              "release_evidence_mode": {"default": "signed_penetration"}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "bounded_penetration"}},
            "required": ["mode"]
          },
          "then": {"required": ["max_contact_penetration_m"]},
          "else": {"not": {"required": ["max_contact_penetration_m"]}}
        },
        {
          "if": {
            "properties": {
              "release_evidence_mode": {"const": "binary_contact"}
            },
            "required": ["release_evidence_mode"]
          },
          "then": {
            "properties": {
              "enforce_max_start_penetration": {"const": false},
              "max_start_penetration_m": {"const": 0},
              "release_tolerance_m": {"const": 0},
              "min_release_progress_m": {"const": 0},
              "require_strictly_decreasing_penetration": {"const": false}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "scene_object": {
      "type": "object",
      "required": [
        "object_id",
        "shape",
        "pose_in_world",
        "attached",
        "attached_to",
        "touch_links",
        "support_contacts",
        "observation"
      ],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "resource_uri", "mesh_scale"],
              "properties": {
                "type": {"const": "mesh"},
                "resource_uri": {"type": "string", "minLength": 1},
                "mesh_scale": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "number"}
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "dimensions_m"],
              "properties": {
                "type": {"const": "box"},
                "dimensions_m": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          ]
        },
        "pose_in_world": {"$ref": "#/$defs/pose"},
        "attached": {"type": "boolean"},
        "attached_to": {"type": "string"},
        "touch_links": {"type": "array", "items": {"type": "string"}},
        "support_contacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/support_contact"}
        },
        "observation": {"type": "object"}
      }
    }
  }
}
