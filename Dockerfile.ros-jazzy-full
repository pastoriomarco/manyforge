# ManyForge ROS Jazzy Full Runtime/Test Environment
#
# Purpose:
#   - Run ManyForge Composer/behavior/RoboPlan and ROS adapters in one image.
#   - Keep ROS Python packages apt-managed while ManyForge application deps live
#     in a pinned venv with --system-site-packages.
#   - Provide the production-shaped integration image for Isaac Sim, ROS drivers,
#     and simulator/robot adapter validation.
#
# This image is heavier than Dockerfile.ros-jazzy.  Keep the lightweight
# ros-jazzy image as the fast ROS adapter lane.

# --- Stage 1: Build React frontend ---
FROM node:22-slim AS frontend-builder
WORKDIR /workspace/manyforge_composer/frontend
COPY manyforge_composer/frontend/package.json manyforge_composer/frontend/package-lock.json* ./
RUN npm ci --ignore-scripts
COPY manyforge_composer/frontend/ ./
# TypeScript also checks contract tests against owner-issued fixtures. Preserve
# the same repository-relative layout as the native development image.
COPY manyforge_deployment/resources/program_binding_lite6_native.fixture.json \
     /workspace/manyforge_deployment/resources/program_binding_lite6_native.fixture.json
COPY manyforge_headless_api/tests/fixtures/control-v2-local-delta.json \
     /workspace/manyforge_headless_api/tests/fixtures/control-v2-local-delta.json
RUN npm run build

# --- Stage 2: ROS + ManyForge runtime ---
FROM ros:jazzy-ros-base-noble

ARG ROBOPLAN_SOURCE_MODE=qualified
# Bound source-build memory on Jetsons; callers may select another job budget.
ARG CMAKE_BUILD_PARALLEL_LEVEL=4
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy
ENV MANYFORGE_VENV=/opt/manyforge/venv
ENV VIRTUAL_ENV=/opt/manyforge/venv
ENV PATH=/opt/manyforge/venv/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/lib
ARG TOPIC_BASED_ROS2_CONTROL_REPO=https://github.com/karanchahal-nv/topic_based_ros2_control.git
ARG TOPIC_BASED_ROS2_CONTROL_REF=7ee291ab13adba52ab5889deb9e520009fe2283d

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        python3-colcon-common-extensions \
        python3-dev \
        python3-pip \
        python3-venv \
        libgtest-dev \
        libgmock-dev \
        libboost-filesystem-dev \
        libboost-serialization-dev \
        libboost-system-dev \
        libboost-python-dev \
        libboost-chrono-dev \
        libboost-thread-dev \
        libboost-date-time-dev \
        libdouble-conversion-dev \
        libeigen3-dev \
        libexpat1-dev \
        libssl-dev \
        libsqlite3-dev \
        libutf8proc-dev \
        libyaml-cpp-dev \
        liburdfdom-dev \
        liboctomap-dev \
        ros-${ROS_DISTRO}-control-msgs \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-simulation-interfaces \
        ros-${ROS_DISTRO}-trajectory-msgs \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-rclpy \
        ros-${ROS_DISTRO}-controller-manager \
        ros-${ROS_DISTRO}-joint-state-broadcaster \
        ros-${ROS_DISTRO}-joint-trajectory-controller \
        ros-${ROS_DISTRO}-ros2-control \
        ros-${ROS_DISTRO}-ros2-controllers \
    && cd /usr/src/googletest && cmake . && make \
    && cp lib/*.a /usr/lib/ \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /tmp/topic_based_ros2_control_ws/src /opt/manyforge/topic_based_ros2_control; \
    git clone "${TOPIC_BASED_ROS2_CONTROL_REPO}" /tmp/topic_based_ros2_control_ws/src/topic_based_ros2_control; \
    cd /tmp/topic_based_ros2_control_ws/src/topic_based_ros2_control; \
    git checkout "${TOPIC_BASED_ROS2_CONTROL_REF}"; \
    cd /tmp/topic_based_ros2_control_ws; \
    set +u; \
    source "/opt/ros/${ROS_DISTRO}/setup.bash"; \
    set -u; \
    colcon build --merge-install --install-base /opt/manyforge/topic_based_ros2_control/install --packages-select topic_based_ros2_control --cmake-args -DBUILD_TESTING=OFF; \
    rm -rf /tmp/topic_based_ros2_control_ws

# This venv runs over a ROS Jazzy base with --system-site-packages, so ROS may
# ship its own urdfdom/eigen/console_bridge. Pin the full Pinocchio 4 cmeel set
# via a constraints file (same set as the slim image) so the cmeel wheels win
# and pip cannot float the new `libpinocchio`/`libcoal` split-out libs or pull a
# mismatched urdfdom soname. cmeel's ldconfig entry then prioritises its libs.
RUN python3 -m venv --system-site-packages "${MANYFORGE_VENV}" \
    && python -m pip install --no-cache-dir --upgrade pip "setuptools<80" \
    && printf '%s\n' \
        'pin==4.1.0' \
        'libpinocchio==4.1.0' \
        'coal==3.0.3' \
        'libcoal==3.0.3' \
        'cmeel-urdfdom==6.0.0' \
        'eigenpy==3.13.0' \
        'cmeel==0.60.0' \
        'cmeel-assimp==6.0.5' \
        'cmeel-boost==1.90.0' \
        'cmeel-console-bridge==1.0.2.3' \
        'cmeel-octomap==1.10.0' \
        'cmeel-qhull==8.0.2.1' \
        'cmeel-tinyxml2==11.0.0' \
        'cmeel-zlib==1.3.1' \
        > /tmp/manyforge-cmeel-constraints.txt \
    && python -m pip install --no-cache-dir -c /tmp/manyforge-cmeel-constraints.txt \
        pytest==9.0.3 \
        numpy==2.3.5 \
        py_trees==2.4.0 \
        pybind11==3.0.3 \
        pyyaml==6.0.3 \
        rfc8785==0.1.4 \
        pillow==10.2.0 \
        trimesh==4.11.5 \
        yourdfpy==0.0.60 \
        nanobind==2.12.0 \
        scikit-build-core==0.12.2 \
        pin==4.1.0 \
        fastapi==0.135.3 \
        "uvicorn[standard]==0.44.0" \
        httpx==0.28.1 \
        httpx2==2.12.0 \
        websockets==16.0 \
        mcp==1.27.0 \
    && python -m pip check \
    && CMEEL_LIB=$(python -c "import site; print(site.getsitepackages()[0])")/cmeel.prefix/lib \
    && if [ -d "$CMEEL_LIB" ]; then echo "$CMEEL_LIB" > /etc/ld.so.conf.d/manyforge-cmeel.conf && ldconfig; fi

# Exact RoboPlan 0.7 source closure with source-built ProxSuite and TOPPRA.
# Prepared on the host by scripts/setup-docker.sh.
COPY .docker/roboplan/ /tmp/roboplan/
COPY .docker/proxsuite/ /tmp/proxsuite/
COPY .docker/toppra/ /tmp/toppra/
COPY third_party/roboplan/ /tmp/roboplan-manifest/
COPY scripts/ci/build-roboplan-source-stack.sh /tmp/build-roboplan-source-stack.sh
COPY scripts/ci/build-roboplan-source-closure.sh /tmp/build-roboplan-source-closure.sh
COPY scripts/ci/verify-external-source-closure.py /tmp/verify-external-source-closure.py
COPY verification/composable_cell_e1/external_delta_ledger.v1.json /tmp/external-delta-ledger.v1.json
COPY scripts/ci/check-roboplan-dependency-stack.py /tmp/check-roboplan-dependency-stack.py
RUN PINOCCHIO_CMAKE_DIR=$(find "${MANYFORGE_VENV}" /usr -name "pinocchioConfig.cmake" -printf '%h\n' 2>/dev/null | head -1) \
    && PINOCCHIO_PREFIX=$(dirname "$(dirname "$(dirname "$PINOCCHIO_CMAKE_DIR")")") \
    && echo "Pinocchio prefix: ${PINOCCHIO_PREFIX}" \
    && if [ "$ROBOPLAN_SOURCE_MODE" = qualified ]; then \
         python /tmp/verify-external-source-closure.py \
           --ledger /tmp/external-delta-ledger.v1.json \
           --source-id roboplan_0_7_0_ua1_foundation --root /tmp/roboplan \
           --content-kind source --allow-stripped-git; \
       elif [ "$ROBOPLAN_SOURCE_MODE" = development_override ]; then \
         echo "RoboPlan development override: exact-source qualification disabled" >&2; \
       else \
         echo "Invalid ROBOPLAN_SOURCE_MODE: $ROBOPLAN_SOURCE_MODE" >&2; exit 2; \
       fi \
    && cd /tmp/roboplan-manifest \
    && sha256sum -c patches.sha256 \
    && umask 0002 \
    && while read -r digest patch; do \
         case "$patch" in patches/*.patch) ;; *) echo "Invalid RoboPlan patch path: $patch" >&2; exit 1;; esac; \
         git -C /tmp/roboplan apply --check "/tmp/roboplan-manifest/$patch"; \
         git -C /tmp/roboplan apply "/tmp/roboplan-manifest/$patch"; \
       done < patches.sha256 \
    && umask 0022 \
    && export CMAKE_PREFIX_PATH="${PINOCCHIO_PREFIX}:${CMAKE_PREFIX_PATH:-}" \
    && export LD_LIBRARY_PATH="${PINOCCHIO_PREFIX}/lib:${LD_LIBRARY_PATH}" \
    && if [ "$ROBOPLAN_SOURCE_MODE" = qualified ]; then DEVELOPMENT_SOURCE=0; else DEVELOPMENT_SOURCE=1; fi \
    && ROBOPLAN_SOURCE_LEDGER=/tmp/external-delta-ledger.v1.json \
       ROBOPLAN_SOURCE_VERIFIER=/tmp/verify-external-source-closure.py \
       ROBOPLAN_SOURCE_ID=roboplan_0_7_0_ua1_foundation \
       ROBOPLAN_ALLOW_STRIPPED_GIT=1 \
       ROBOPLAN_ALLOW_DEVELOPMENT_SOURCE="$DEVELOPMENT_SOURCE" \
       bash /tmp/build-roboplan-source-closure.sh \
         /tmp/proxsuite /tmp/toppra /tmp/roboplan \
         -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
         -DBUILD_PYTHON_BINDINGS=OFF \
    && CLOSURE_INSTALL=/tmp/roboplan-install-closure \
    && for prefix in \
         "${CLOSURE_INSTALL}/proxsuite" \
         "${CLOSURE_INSTALL}/toppra"; do \
         test -d "$prefix" || { echo "Missing exact install prefix: $prefix" >&2; exit 1; }; \
         cp -a "$prefix/." /usr/local/; \
       done \
    && ldconfig \
    && ROBOPLAN_SITE_PACKAGES=$(python -c "import site; print(site.getsitepackages()[0])") \
    && export CMAKE_PREFIX_PATH="${ROBOPLAN_SITE_PACKAGES}:/usr/local:${PINOCCHIO_PREFIX}" \
    && export LD_LIBRARY_PATH="${ROBOPLAN_SITE_PACKAGES}/lib:/usr/local/lib:${PINOCCHIO_PREFIX}/lib" \
    && export CMAKE_ARGS="-DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_UPDATES_DISCONNECTED=ON" \
    && for py_pkg in roboplan_common roboplan_example_models roboplan_core roboplan_simple_ik roboplan_oink roboplan_toppra roboplan_rrt roboplan_cartesian_planning roboplan; do \
         cd "/tmp/roboplan/${py_pkg}"; \
         python -m pip install --no-build-isolation --no-deps --no-cache-dir -v .; \
       done \
    && printf '%s\n' "${ROBOPLAN_SITE_PACKAGES}/lib" > /etc/ld.so.conf.d/manyforge-roboplan.conf \
    && ldconfig \
    && python -m pip check \
    && python /tmp/check-roboplan-dependency-stack.py \
    && rm -rf /tmp/roboplan /tmp/proxsuite /tmp/toppra /tmp/roboplan-manifest \
         /tmp/roboplan-build-closure /tmp/roboplan-install-closure \
         /tmp/build-roboplan-source-stack.sh /tmp/build-roboplan-source-closure.sh \
         /tmp/verify-external-source-closure.py /tmp/external-delta-ledger.v1.json \
         /tmp/check-roboplan-dependency-stack.py

# The venv distributions are the sole RoboPlan runtime/CMake prefix. The
# disconnected C++ closure is removed in the same layer and cannot compete at
# import, link, or later ManyForge configure time.
ENV CMAKE_PREFIX_PATH=/opt/manyforge/venv/lib/python3.12/site-packages:/opt/manyforge/venv/lib/python3.12/site-packages/cmeel.prefix:/usr/local
ENV LD_LIBRARY_PATH=/opt/manyforge/venv/lib/python3.12/site-packages/lib:/usr/local/lib

WORKDIR /workspace

# Keep the source-tree CLI available to direct `docker exec` commands. The
# wrapper establishes its own PYTHONPATH, so it does not depend on PID 1's
# entrypoint environment.
ENV PATH="/workspace/scripts:${PATH}"

RUN set -eux; \
    if ! getent group 1000 >/dev/null; then groupadd --gid 1000 manyforge; fi; \
    if ! getent passwd 1000 >/dev/null; then \
        useradd --create-home --shell /bin/bash --uid 1000 --gid 1000 manyforge; \
    fi; \
    user_home="$(getent passwd 1000 | cut -d: -f6)"; \
    mkdir -p /tmp/manyforge-build /workspace /opt/manyforge-frontend/dist "${user_home}"; \
    chown -R 1000:1000 /tmp/manyforge-build /workspace "${user_home}" /opt/manyforge

# Node.js 22 for Composer frontend builds in the full ROS image.
COPY --from=frontend-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend-builder /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=frontend-builder --chown=1000:1000 /workspace/manyforge_composer/frontend/dist/ /opt/manyforge-frontend/dist/

COPY docker-entrypoint.ros-jazzy-full.sh /usr/local/bin/
# ament_python console scripts use the ROS system interpreter even though
# interactive commands select the application venv. Keep the exact
# canonical-JSON dependency available on both interpreter paths.
RUN chmod +x /usr/local/bin/docker-entrypoint.ros-jazzy-full.sh \
    && /usr/bin/python3 -m pip install --break-system-packages --no-cache-dir \
        --no-deps rfc8785==0.1.4 \
    && /usr/bin/python3 -c "import rfc8785"

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.ros-jazzy-full.sh"]
CMD ["bash"]
