      "requirements": {"no_client": true, "zero_builds": true, "client_count_max": 0, "active_client_count_min": 0},
      "budgets": {"viewer_route_p95_ms": 10.0, "process_cpu_p95_percent": {"composer": 25.0, "viewer_worker": 1.0}, "build_failures_max": 0, "publication_sink_drops_max": 0},
      "required_process_labels": ["composer", "viewer_worker"],
      "preconditions": ["Close every Composer browser tab and wait at least one second for disconnect grace to expire."]
    },
    {
      "name": "hidden",
