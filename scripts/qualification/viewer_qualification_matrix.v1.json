      "budgets": {"viewer_route_p95_ms": 10.0, "process_cpu_p95_percent": {"composer": 25.0, "viewer_worker": 1.0, "browser": 30.0}, "client_long_tasks_max": 0, "build_failures_max": 0, "publication_sink_drops_max": 0},
      "required_process_labels": ["composer", "viewer_worker", "browser"],
      "preconditions": ["Open the Composer viewer, then background or minimize the browser so document.hidden is true."]
    },
