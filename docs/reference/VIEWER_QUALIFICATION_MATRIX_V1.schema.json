            "type": "number"
          },
          "title": "Kernel Counter Delta Min",
          "type": "object"
        },
        "kernel_state_sample_min": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Kernel State Sample Min",
          "type": "object"
        },
        "no_client": {
          "default": false,
          "title": "No Client",
          "type": "boolean"
