          "type": "array"
        },
        "viewer_counter_delta_min": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Viewer Counter Delta Min",
          "type": "object"
        },
        "zero_builds": {
          "default": false,
          "title": "Zero Builds",
          "type": "boolean"
        }
      },
      "title": "ViewerQualificationRequirementsV1",
      "type": "object"
    },
    "ViewerQualificationScenarioV1": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/ViewerQualificationBudgetsV1"
        },
        "capture": {
          "$ref": "#/$defs/ViewerQualificationCaptureV1"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "observer_paths": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Observer Paths",
          "type": "object"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "required_process_labels": {
          "items": {
            "type": "string"
          },
          "title": "Required Process Labels",
          "type": "array"
        },
        "requirements": {
          "$ref": "#/$defs/ViewerQualificationRequirementsV1"
        }
      },
      "required": [
        "name",
        "description",
        "capture",
        "requirements",
        "budgets"
      ],
      "title": "ViewerQualificationScenarioV1",
      "type": "object"
    }
