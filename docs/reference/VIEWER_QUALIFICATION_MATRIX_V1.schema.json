        "client_long_tasks_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Long Tasks Max"
        },
        "client_materialization_max_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Materialization Max Ms"
        },
        "client_react_commits_per_frame_max": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client React Commits Per Frame Max"
        },
        "client_unmatched_topology_rebuilds_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Unmatched Topology Rebuilds Max"
        },
        "process_cpu_p95_percent": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Process Cpu P95 Percent",
          "type": "object"
        },
        "publication_sink_drops_max": {
          "default": 0,
          "minimum": 0,
          "title": "Publication Sink Drops Max",
          "type": "integer"
        },
        "viewer_route_p95_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Viewer Route P95 Ms",
          "type": "number"
        }
      },
      "required": [
        "viewer_route_p95_ms"
      ],
      "title": "ViewerQualificationBudgetsV1",
      "type": "object"
    },
    "ViewerQualificationCaptureV1": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "exclusiveMinimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "hz": {
          "exclusiveMinimum": 0.0,
          "title": "Hz",
          "type": "number"
        },
        "timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Timeout S",
          "type": "number"
        },
        "warmup_s": {
          "minimum": 0.0,
          "title": "Warmup S",
          "type": "number"
        }
      },
      "required": [
        "duration_s",
        "warmup_s",
        "hz",
        "timeout_s"
      ],
      "title": "ViewerQualificationCaptureV1",
      "type": "object"
    },
    "ViewerQualificationRequirementsV1": {
      "additionalProperties": false,
      "properties": {
        "active_client": {
          "default": false,
          "title": "Active Client",
          "type": "boolean"
