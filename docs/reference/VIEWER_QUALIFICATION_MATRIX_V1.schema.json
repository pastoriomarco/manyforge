  "$id": "https://manyforge.dev/schemas/viewer-qualification-matrix-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "additionalProperties": true,
      "title": "Policy",
      "type": "object"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ViewerQualificationScenarioV1"
      },
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "manyforge.viewer.qualification_matrix.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "scenarios"
  ],
  "title": "ViewerQualificationMatrixV1",
  "type": "object"
}
