<?xml version="1.0"?>
<robot name="composable_tool">
  <link name="tool_root"/>
  <link name="finger"/>
  <joint name="finger_joint" type="prismatic">
    <parent link="tool_root"/>
    <child link="finger"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="0.1"/>
  </joint>
</robot>
