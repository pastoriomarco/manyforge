+/// @brief Maximum nominal reference intervals used to build one feedrate envelope.
+/// @details One million 10 ms intervals admits roughly 2.8 hours of nominal motion while placing
+/// a deterministic bound on the temporary envelope allocation.
+constexpr double kMaxBoundedReferenceIntervals = 1'000'000.0;
+
+/// @brief Maximum conservative servo-loop budget after retry and acceleration-profile overhead.
+/// @details Keeping the estimate in double until this bound is proven prevents overflowing the
+/// loop's integer accounting for hostile but finite speed or acceleration values.
+constexpr double kMaxBoundedServoStepBudget = 1'000'000.0;
+
 constexpr const char* kCancellationError = "Cartesian planning cancelled.";
+constexpr const char* kReferenceBudgetError =
+    "Cartesian reference exceeds the bounded control-step budget.";
 
