+TEST_F(RoboPlanToppraTest, NonFiniteSamplingOptionsAreRejected) {
+  const auto path = createTestPathShort();
+  auto toppra = PathParameterizerTOPPRA(scene, "arm");
+
+  for (const auto dt :
+       {std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::infinity()}) {
+    const auto result = toppra.generate(path, {dt});
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), "dt must be strictly positive.");
+  }
+
+  TOPPRAOptions options;
+  options.velocity_scale = std::numeric_limits<double>::quiet_NaN();
+  auto result = toppra.generate(path, options);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(),
+            "Velocity scale must be greater than 0.0 and less than or equal to 1.0.");
+
+  options.velocity_scale = 1.0;
+  options.acceleration_scale = std::numeric_limits<double>::infinity();
+  result = toppra.generate(path, options);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(),
+            "Acceleration scale must be greater than 0.0 and less than or equal to 1.0.");
+}
+
+TEST_F(RoboPlanToppraTest, OutputSampleBudgetIsCheckedBeforeAllocation) {
+  const auto path = createTestPathShort();
+  auto toppra = PathParameterizerTOPPRA(scene, "arm");
+
+  TOPPRAOptions options;
+  options.max_output_samples = 0;
+  auto result = toppra.generate(path, options);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), "max_output_samples must be strictly positive.");
+
+  options.max_output_samples = 1;
+  result = toppra.generate(path, options);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), "Trajectory exceeds max_output_samples.");
+}
