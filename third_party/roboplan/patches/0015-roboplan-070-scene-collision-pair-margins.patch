+tl::expected<void, std::string> Scene::setCollisionPairMargins(std::span<const double> margins_m) {
+  if (margins_m.size() != collision_model_.collisionPairs.size()) {
+    return tl::make_unexpected("Could not set collision pair margins: expected " +
+                               std::to_string(collision_model_.collisionPairs.size()) +
+                               " margins, got " + std::to_string(margins_m.size()) + ".");
+  }
+  if (!std::all_of(margins_m.begin(), margins_m.end(),
+                   [](double margin) { return std::isfinite(margin) && margin >= 0.0; })) {
+    return tl::make_unexpected(
+        "Could not set collision pair margins: margins must be finite and non-negative.");
+  }
+  for (size_t k = 0; k < margins_m.size(); ++k) {
+    collision_model_data_->collisionRequests[k].security_margin = margins_m[k];
+  }
+  // The broadphase inflates each AABB by its margin when it is built.
+  rebuildBroadphaseManager();
+  return {};
+}
