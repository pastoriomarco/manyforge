+  static CollisionQueryView forIsolatedContext(
+      const CollisionContext& context) noexcept;
+
+  // The isolated form borrows its context and therefore must not be created
+  // from a temporary whose lifetime ends before the returned view is used.
+  static CollisionQueryView forIsolatedContext(CollisionContext&&) = delete;
+  static CollisionQueryView forIsolatedContext(
+      const CollisionContext&&) = delete;
+
+  [[nodiscard]]
+  static CollisionQueryView forSerializedScene(
+      std::shared_ptr<const Scene> scene);
