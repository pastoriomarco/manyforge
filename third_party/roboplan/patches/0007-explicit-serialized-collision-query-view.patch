+std::optional<Eigen::VectorXd> Scene::randomCollisionFreePositions(
+    const CollisionQueryView& collision_query, size_t max_samples) {
+  if (collision_query.sourceScene() != this) {
+    throw std::invalid_argument(
+        "Collision query and random sampler must use the same Scene generation");
+  }
+  for (size_t idx = 0; idx < max_samples; ++idx) {
+    const auto positions = randomPositions();
+    if (!collision_query.hasCollisions(positions)) {
+      return positions;
+    }
+  }
+  return std::nullopt;
+}
