+CollisionQueryView::CollisionQueryView(
+    const CollisionContext* isolated_context,
+    std::shared_ptr<const Scene> scene_owner,
+    const Scene* source_scene) noexcept
+    : isolated_context_(isolated_context),
+      scene_owner_(std::move(scene_owner)), source_scene_(source_scene) {}
+
+CollisionQueryView CollisionQueryView::forIsolatedContext(
+    const CollisionContext& context) noexcept {
+  return CollisionQueryView(&context, nullptr, context.sourceScene());
+}
+
+CollisionQueryView CollisionQueryView::forSerializedScene(
+    std::shared_ptr<const Scene> scene) {
+  if (!scene) {
+    throw std::invalid_argument(
+        "CollisionQueryView requires a non-null serialized scene owner");
+  }
+  const Scene* source_scene = scene.get();
+  return CollisionQueryView(nullptr, std::move(scene), source_scene);
+}
+
+bool CollisionQueryView::hasCollisions(const Eigen::VectorXd& q) const {
+  if (isolated_context_ != nullptr) {
+    return isolated_context_->hasCollisions(q);
+  }
+  return scene_owner_->hasCollisions(q);
+}
+
 }  // namespace roboplan
