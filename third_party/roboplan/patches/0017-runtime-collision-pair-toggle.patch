+tl::expected<void, std::string>
+Scene::setCollisionPairsActive(const std::vector<std::pair<std::string, std::string>>& pairs,
+                               const bool active) {
+  const auto maybe_pairs = getCollisionPairs(pairs);
+  if (!maybe_pairs) {
+    return tl::make_unexpected("Could not set collision pairs active: " + maybe_pairs.error());
+  }
+  for (const auto& pair : maybe_pairs.value()) {
+    const auto index = collision_model_.findCollisionPair(pair);
+    if (index < collision_model_.collisionPairs.size()) {
+      collision_model_data_->activeCollisionPairs[index] = active;
+    }
+  }
+  return {};
+}
