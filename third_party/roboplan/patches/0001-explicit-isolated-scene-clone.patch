+Scene::Scene(const Scene& other)
+    : name_(other.name_), model_(other.model_), model_data_(model_),
+      collision_model_(other.collision_model_), collision_model_data_(collision_model_),
+      joint_names_(other.joint_names_), actuated_joint_names_(other.actuated_joint_names_),
+      joint_info_map_(other.joint_info_map_), joint_group_info_map_(other.joint_group_info_map_),
+      rng_gen_(other.rng_gen_), cur_state_(other.cur_state_), frame_map_(other.frame_map_),
+      collision_geometry_map_(other.collision_geometry_map_) {
+  rebuildBroadphaseManager();
+}
+
+std::shared_ptr<Scene> Scene::clone() const { return std::make_shared<Scene>(*this); }
+
+void Scene::replaceWithIsolatedCopy(const Scene& other) {
+  if (this == &other) {
+    return;
+  }
+
+  // Construct every potentially-throwing copy before changing the live scene. The old
+  // broadphase manager is released before model/data swaps because it caches pointers into both.
+  Scene replacement(other);
+  broadphase_manager_.reset();
+  replacement.broadphase_manager_.reset();
+
+  const auto swap_state = [&]() {
+    using std::swap;
+    swap(name_, replacement.name_);
+    swap(model_, replacement.model_);
+    swap(model_data_, replacement.model_data_);
+    swap(collision_model_, replacement.collision_model_);
+    swap(collision_model_data_, replacement.collision_model_data_);
+    swap(joint_names_, replacement.joint_names_);
+    swap(actuated_joint_names_, replacement.actuated_joint_names_);
+    swap(joint_info_map_, replacement.joint_info_map_);
+    swap(joint_group_info_map_, replacement.joint_group_info_map_);
+    swap(rng_gen_, replacement.rng_gen_);
+    swap(cur_state_, replacement.cur_state_);
+    swap(frame_map_, replacement.frame_map_);
+    swap(collision_geometry_map_, replacement.collision_geometry_map_);
+  };
+
+  swap_state();
+  try {
+    rebuildBroadphaseManager();
+  } catch (...) {
+    // Restore the previously valid state before reporting commit failure. Failure to rebuild that
+    // state means collision queries can no longer be made safely, so continuing is not permitted.
+    broadphase_manager_.reset();
+    swap_state();
+    try {
+      rebuildBroadphaseManager();
+    } catch (...) {
+      std::terminate();
+    }
+    throw;
+  }
+}
+
