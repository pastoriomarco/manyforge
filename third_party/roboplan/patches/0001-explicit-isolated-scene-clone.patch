+  /// @brief Deep-copy constructor.
+  /// @details Copies immutable model/geometry state and logical scene state, then reconstructs
+  /// all mutable Pinocchio scratch and the broadphase manager against this Scene's own members.
+  /// No pointer-bearing collision scratch is shared with `other`.
+  Scene(const Scene& other);
+
+  // The broadphase manager caches pointers into this object, so an implicit move would leave it
+  // bound to the moved-from Scene. Assignment has no synchronization contract and is intentionally
+  // disabled; callers that own exclusive access use replaceWithIsolatedCopy() explicitly.
+  Scene& operator=(const Scene&) = delete;
+  Scene(Scene&&) = delete;
+  Scene& operator=(Scene&&) = delete;
+
+  /// @brief Creates an isolated scene generation.
+  /// @return A deep copy whose collision scratch and broadphase pointers are self-owned.
+  std::shared_ptr<Scene> clone() const;
+
+  /// @brief Transactionally replaces this mutable scene from an isolated copy of `other`.
+  /// @details The replacement is fully constructed before this object changes. Pointer-bearing
+  /// collision scratch is discarded and rebuilt against this object's new model members. The
+  /// caller must hold exclusive access to this Scene for the full call; retained generations must
+  /// use clone() and must never be updated through this method.
+  void replaceWithIsolatedCopy(const Scene& other);
+
   /// @brief Gets the scene's name.
   /// @return The scene name.
   const std::string& getName() const { return name_; };
