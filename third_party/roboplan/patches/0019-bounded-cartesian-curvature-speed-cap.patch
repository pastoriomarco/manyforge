+// On a rounded corner, Bounded mode slows the tool down only along the arc, so that its lateral
+// acceleration v^2 / r stays within the linear acceleration limit, and runs through it without a
+// stop.
+TEST_F(CartesianPlannerTest, BoundedModeSlowsOnlyOnCurves) {
+  JointConfiguration q_start;
+  q_start.positions = scene_->getCurrentJointPositions();
+  q_start.positions.head(6) << 0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0;
+  scene_->setJointPositions(q_start.positions);
+
+  CartesianPlannerOptions options;
+  options.group_name = kGroup;
+  options.speed_mode = CartesianSpeedMode::Bounded;
+  options.max_linear_speed = 0.15;
+  options.max_linear_acceleration = 0.4;
+  // Resolve the arc finely enough that the sampled tool positions follow its curve.
+  options.position_tolerance = 0.001;
+  CartesianPathPlanner planner(scene_, options);
+
+  // Along base y, a quarter circle of radius 10 mm in 0.05 rad steps, then along base z.
+  constexpr double kRadius = 0.01;
+  const Eigen::Matrix4d start = scene_->forwardKinematics(q_start.positions, kTipFrame, kBaseFrame);
+  std::vector<Eigen::Matrix4d> waypoints{start};
+  for (int k = 0; k <= 32; ++k) {
+    const double angle = 0.5 * M_PI * k / 32;
+    Eigen::Matrix4d pose = start;
+    pose(1, 3) += 0.1 + kRadius * std::sin(angle);
+    pose(2, 3) += kRadius * (1.0 - std::cos(angle));
+    waypoints.push_back(pose);
+  }
+  Eigen::Matrix4d end = waypoints.back();
+  end(2, 3) += 0.1;
+  waypoints.push_back(end);
+  const auto result =
+      planner.plan(CartesianPath({kBaseFrame}, {kTipFrame}, {waypoints}), q_start);
+  ASSERT_TRUE(result.has_value()) << result.error();
+
+  std::vector<Eigen::Vector3d> positions;
+  for (const auto& q : result->positions) {
+    const Eigen::VectorXd q_full = scene_->toFullJointPositions(kGroup, q);
+    positions.push_back(scene_->forwardKinematics(q_full, kTipFrame, kBaseFrame).block<3, 1>(0, 3));
+  }
+  const double arc_speed = std::sqrt(options.max_linear_acceleration * kRadius);
+  double peak_speed = 0.0;
+  double min_speed = std::numeric_limits<double>::infinity();
+  for (size_t i = 1; i + 1 < positions.size(); ++i) {
+    const double speed = (positions.at(i + 1) - positions.at(i - 1)).norm() / (2.0 * options.dt);
+    peak_speed = std::max(peak_speed, speed);
+    // On the arc: slow enough for its curvature, but still moving.
+    const Eigen::Vector3d offset = positions.at(i) - start.block<3, 1>(0, 3);
+    if (offset.y() > 0.1 + 1e-3 && offset.z() < kRadius - 1e-3) {
+      EXPECT_LE(speed, 1.05 * arc_speed);
+      min_speed = std::min(min_speed, speed);
+    }
+    // The tool's whole acceleration stays within the linear limit.
+    const Eigen::Vector3d acceleration =
+        (positions.at(i + 1) - 2.0 * positions.at(i) + positions.at(i - 1)) /
+        (options.dt * options.dt);
+    EXPECT_LE(acceleration.norm(), 1.1 * options.max_linear_acceleration);
+  }
+  EXPECT_GT(min_speed, 0.5 * arc_speed);
+  EXPECT_NEAR(peak_speed, options.max_linear_speed, 0.002);
+}
