+// A path-velocity bound caps a speed that is not a joint limit, here the joint-space speed norm,
+// at every grid point. Only the stretches near the cap slow down, so the bounded trajectory is
+// faster than stretching the unbounded one uniformly down to the same cap.
+TEST_F(RoboPlanToppraTest, PathVelocityBoundCapsSpeedOnlyWhereItBinds) {
+  auto path = createTestPathLong();
+  auto toppra = PathParameterizerTOPPRA(scene, "arm");
+  TOPPRAOptions options;
+  const auto unbounded = toppra.generate(path, options);
+  ASSERT_TRUE(unbounded.has_value()) << unbounded.error();
+  double unbounded_peak = 0.0;
+  for (const auto& velocity : unbounded->velocities) {
+    unbounded_peak = std::max(unbounded_peak, velocity.norm());
+  }
+
+  const double cap = 0.5 * unbounded_peak;
+  size_t calls = 0;
+  options.max_path_velocity = [&](const Eigen::VectorXd& q, const Eigen::VectorXd& dq_ds) {
+    ++calls;
+    EXPECT_EQ(q.size(), 6);
+    EXPECT_EQ(dq_ds.size(), 6);
+    const double norm = dq_ds.norm();
+    return norm > 0.0 ? cap / norm : std::numeric_limits<double>::infinity();
+  };
+  const auto bounded = toppra.generate(path, options);
+  ASSERT_TRUE(bounded.has_value()) << bounded.error();
+  EXPECT_GT(calls, 0U);
+  for (const auto& velocity : bounded->velocities) {
+    EXPECT_LE(velocity.norm(), cap * 1.02);
+  }
+  // The uniformly stretched unbounded trajectory is feasible for the bounded problem.
+  EXPECT_LT(bounded->times.back(), unbounded->times.back() * (unbounded_peak / cap));
+  EXPECT_GT(bounded->times.back(), unbounded->times.back());
+}
