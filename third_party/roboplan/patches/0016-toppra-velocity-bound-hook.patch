+/// @brief Bounds the path speed at each grid point with TOPPRAOptions::max_path_velocity.
+class PathVelocityBound : public toppra::LinearConstraint {
+public:
+  PathVelocityBound(const roboplan::Scene& scene, const std::string& group_name,
+                    std::function<double(const Eigen::VectorXd&, const Eigen::VectorXd&)> bound)
+      : toppra::LinearConstraint(0, 0, true, false, true), scene_{scene}, group_name_{group_name},
+        bound_{std::move(bound)} {}
+
+private:
+  void computeParams_impl(const toppra::GeometricPath& path, const toppra::Vector& gridpoints,
+                          toppra::Vectors&, toppra::Vectors&, toppra::Vectors&, toppra::Matrices&,
+                          toppra::Vectors&, toppra::Bounds&, toppra::Bounds& xbound) override {
+    for (Eigen::Index i = 0; i < gridpoints.size(); ++i) {
+      const auto q = roboplan::expandContinuousJointPositions(
+                         scene_, group_name_, path.eval_single(gridpoints[i], 0))
+                         .value();
+      // Same ceiling as toppra::constraint::LinearJointVelocity, so "no bound" stays finite.
+      const double sd_max = std::min(1e8, bound_(q, path.eval_single(gridpoints[i], 1)));
+      xbound[i][0] = 0.0;
+      xbound[i][1] = sd_max * sd_max;
+    }
+  }
+
+  const roboplan::Scene& scene_;
+  std::string group_name_;
+  std::function<double(const Eigen::VectorXd&, const Eigen::VectorXd&)> bound_;
+};
