    cd /tmp/xarm_description_ws/src/xarm_ros2; \
    git sparse-checkout init --cone; \
    git sparse-checkout set xarm_description; \
    git checkout "${XARM_DESCRIPTION_REF}"; \
    test "$(git rev-parse HEAD)" = "c3172e57c1c1bb2982fc008304ad6bc886357c87"; \
