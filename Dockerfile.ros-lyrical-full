# --- ROS dependency overlays used by every lane (Mock, Isaac, Real) ---
# The entrypoint sources them in this order: xArm driver, controller overlay
# last. Every source is pinned by commit.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-launch-param-builder \
        ros-${ROS_DISTRO}-robot-state-publisher \
        ros-${ROS_DISTRO}-urdf \
    && rm -rf /var/lib/apt/lists/*

# Stock JTC 6.10.0 controller overlay: apt ros2_control plus source JTC 6.10.0
# (ros2_controllers tag 6.10.0), realtime_tools 5.4.0 and ros2_control_cmake 1.0.0.
ARG ROS2_CONTROL_CMAKE_COMMIT=10b9df0d804c2880e7dc50927f8fd82c7198bda4
ARG REALTIME_TOOLS_COMMIT=f2f8ee08580659e0ee673a8cdbd1a83b274e9d4a
ARG ROS2_CONTROLLERS_COMMIT=0c702e0e938f94a9cc04c45e014ffdc4667f940e
RUN set -euo pipefail; \
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
    ws=/tmp/control_overlay_ws; mkdir -p "${ws}/src"; \
    fetch() { \
      git init -q "${ws}/src/$1"; \
      git -C "${ws}/src/$1" fetch -q --depth 1 "https://github.com/ros-controls/$1" "$2"; \
      git -C "${ws}/src/$1" checkout -q FETCH_HEAD; \
      test "$(git -C "${ws}/src/$1" rev-parse HEAD)" = "$2"; \
    }; \
    fetch ros2_control_cmake "${ROS2_CONTROL_CMAKE_COMMIT}"; \
    fetch realtime_tools "${REALTIME_TOOLS_COMMIT}"; \
    fetch ros2_controllers "${ROS2_CONTROLLERS_COMMIT}"; \
    set +u; source "/opt/ros/${ROS_DISTRO}/setup.bash"; set -u; \
    cd "${ws}"; \
    colcon build --install-base /opt/manyforge/control_overlay \
        --packages-select ros2_control_cmake realtime_tools joint_trajectory_controller \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF; \
    printf 'ros2_control_cmake %s\nrealtime_tools %s\nros2_controllers %s\n' \
        "${ROS2_CONTROL_CMAKE_COMMIT}" "${REALTIME_TOOLS_COMMIT}" "${ROS2_CONTROLLERS_COMMIT}" \
        > /opt/manyforge/control_overlay/UPSTREAM_COMMITS; \
    rm -rf "${ws}"

# UFactory xArm driver (xArm 5/6/7, Lite 6, UF850) from the fork
# branch `lyrical-no-gazebo` (upstream lyrical + the xarm_io_states topic and
# system_control service; gazebo packages removed), built against the controller
# overlay above.
ARG XARM_SOURCE_REPOSITORY=https://github.com/pastoriomarco/xarm_ros2
ARG XARM_SOURCE_COMMIT=46aa1147d99963a8357b89744633db428746667b
ARG XARM_SDK_COMMIT=f36794320a285c0b4bf1cd8ef181cbff6e3b794a
RUN set -euo pipefail; \
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
    ws=/opt/manyforge/xarm_ws; mkdir -p "${ws}/src"; \
    git clone -q "${XARM_SOURCE_REPOSITORY}" "${ws}/src/xarm_ros2"; \
    cd "${ws}/src/xarm_ros2"; \
    git checkout -q "${XARM_SOURCE_COMMIT}"; \
    git submodule update --init --recursive -q; \
    test "$(git -C xarm_sdk/cxx rev-parse HEAD)" = "${XARM_SDK_COMMIT}"; \
    printf 'xarm_ros2 %s\nxarm_sdk %s\n' "$(git rev-parse HEAD)" "${XARM_SDK_COMMIT}" > "${ws}/UPSTREAM_COMMITS"; \
    rm -rf .git xarm_sdk/cxx/.git; \
    set +u; source "/opt/ros/${ROS_DISTRO}/setup.bash"; \
    source /opt/manyforge/control_overlay/setup.bash; set -u; \
    cd "${ws}"; \
    colcon build --packages-up-to xarm_controller xarm_api uf_ros_lib \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF; \
    rm -rf build log


# The venv distributions are the sole RoboPlan runtime/CMake prefix. The
# disconnected C++ closure is removed in the same layer and cannot compete at
# import, link, or later ManyForge configure time.
ENV CMAKE_PREFIX_PATH=/opt/manyforge/venv/lib/python3.12/site-packages:/opt/manyforge/venv/lib/python3.12/site-packages/cmeel.prefix:/usr/local
ENV LD_LIBRARY_PATH=/opt/manyforge/venv/lib/python3.12/site-packages/lib:/usr/local/lib

WORKDIR /workspace

# Keep the source-tree CLI available to direct `docker exec` commands. The
# wrapper establishes its own PYTHONPATH, so it does not depend on PID 1's
# entrypoint environment.
ENV PATH="/workspace/scripts:${PATH}"

RUN set -eux; \
    if ! getent group 1000 >/dev/null; then groupadd --gid 1000 manyforge; fi; \
    if ! getent passwd 1000 >/dev/null; then \
        useradd --create-home --shell /bin/bash --uid 1000 --gid 1000 manyforge; \
    fi; \
    user_home="$(getent passwd 1000 | cut -d: -f6)"; \
    mkdir -p /tmp/manyforge-build /workspace /opt/manyforge-frontend/dist "${user_home}"; \
    chown -R 1000:1000 /tmp/manyforge-build /workspace "${user_home}" /opt/manyforge

# Node.js 22 for Composer frontend builds in the full ROS image.
COPY --from=frontend-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend-builder /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=frontend-builder --chown=1000:1000 /workspace/manyforge_composer/frontend/dist/ /opt/manyforge-frontend/dist/

# LYRICAL: the Jazzy entrypoint is reused unchanged; it sources
# /opt/ros/${ROS_DISTRO} and ROS_DISTRO=lyrical is set above.
COPY docker-entrypoint.ros-jazzy-full.sh /usr/local/bin/
# ament_python console scripts use the ROS system interpreter even though
# interactive commands select the application venv. Keep the exact
# canonical-JSON dependency available on both interpreter paths.
RUN chmod +x /usr/local/bin/docker-entrypoint.ros-jazzy-full.sh \
    && /usr/bin/python3 -m pip install --break-system-packages --no-cache-dir \
        --no-deps rfc8785==0.1.4 \
    && /usr/bin/python3 -c "import rfc8785"

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.ros-jazzy-full.sh"]
CMD ["bash"]
