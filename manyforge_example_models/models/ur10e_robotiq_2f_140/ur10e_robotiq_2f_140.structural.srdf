<?xml version="1.0"?>
<!--
  Minimal SRDF for UR10e + Robotiq 2F-140.

  This is intentionally scoped to the ManyForge/RoboPlan use case:
  - one arm planning group from base_link_inertia to tool0
  - disabled collisions for adjacent/fixed robot links
  - disabled collisions for the rigidly mounted Robotiq assembly

  The gripper actuation group exposes the Robotiq driver joint only.
-->
<robot name="ur10e_robotiq_2f_140">
  <group name="arm">
    <chain base_link="base_link_inertia" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="finger_joint"/>
  </group>
  <group_state name="open" group="gripper">
    <joint name="finger_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="finger_joint" value="0.66"/>
  </group_state>

  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>

  <disable_collisions link1="wrist_3_link" link2="robotiq_base_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="robotiq_base_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_base_link" link2="left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_base_link" link2="left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_base_link" link2="right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_base_link" link2="right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_base_link" link2="gripper_frame" reason="Adjacent"/>
  <disable_collisions link1="left_outer_knuckle" link2="left_outer_finger" reason="Adjacent"/>
  <disable_collisions link1="left_outer_knuckle" link2="left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="left_outer_finger" link2="left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="left_inner_finger" link2="left_inner_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="left_inner_knuckle" link2="left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="right_outer_finger" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="right_inner_finger" link2="right_inner_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_frame" link2="grasp_frame" reason="Adjacent"/>
  <disable_collisions link1="gripper_frame" link2="insertion_frame" reason="Adjacent"/>
</robot>
