<?xml version="1.0"?>
<!--
  Static ManyForge SRDF for UFACTORY Lite6 + lite pneumatic gripper.
  Materialized from xarm_moveit_config/srdf/xarm.srdf.xacro through
  ManyMove's Lite6 bringup with prefix='', robot_type=lite, dof=6,
  add_gripper=true.
-->
<robot name="lite6_lite_gripper">
  <group name="lite6">
    <joint name="world_joint"/>
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="joint5"/>
    <joint name="joint6"/>
    <joint name="joint_eef"/>
    <joint name="gripper_fix"/>
    <joint name="joint_tcp"/>
  </group>
  <group_state name="home" group="lite6">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="hold-up" group="lite6">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="-1.5708"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group name="lite_gripper">
    <link name="lite_gripper_base_link"/>
    <link name="lite_gripper_left_finger"/>
    <link name="lite_gripper_right_finger"/>
    <link name="link_tcp"/>
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>
  <group_state name="open" group="lite_gripper">
    <joint name="left_finger_joint" value="0.0081"/>
    <joint name="right_finger_joint" value="0.0081"/>
  </group_state>
  <group_state name="close" group="lite_gripper">
    <joint name="left_finger_joint" value="0"/>
    <joint name="right_finger_joint" value="0"/>
  </group_state>
  <group_state name="closed" group="lite_gripper">
    <joint name="left_finger_joint" value="0"/>
    <joint name="right_finger_joint" value="0"/>
  </group_state>
  <end_effector name="lite_gripper" parent_link="link_tcp" group="lite_gripper"/>
  <disable_collisions link1="lite_gripper_left_finger" link2="lite_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="lite_gripper_right_finger" link2="lite_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="lite_gripper_left_finger" link2="lite_gripper_right_finger" reason="Never"/>
  <disable_collisions link1="lite_gripper_left_finger" link2="link4" reason="Never"/>
  <disable_collisions link1="lite_gripper_left_finger" link2="link5" reason="Never"/>
  <disable_collisions link1="lite_gripper_left_finger" link2="link6" reason="Never"/>
  <disable_collisions link1="lite_gripper_right_finger" link2="link4" reason="Never"/>
  <disable_collisions link1="lite_gripper_right_finger" link2="link5" reason="Never"/>
  <disable_collisions link1="lite_gripper_right_finger" link2="link6" reason="Never"/>
  <disable_collisions link1="link6" link2="lite_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="lite_gripper_base_link" reason="Never"/>
  <disable_collisions link1="link_eef" link2="lite_gripper_left_finger" reason="Never"/>
  <disable_collisions link1="link_eef" link2="lite_gripper_right_finger" reason="Never"/>
  <disable_collisions link1="link_eef" link2="lite_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link_base" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="link_base" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link_eef" reason="Never"/>
  <disable_collisions link1="link5" link2="link_eef" reason="Never"/>
  <disable_collisions link1="link6" link2="link_eef" reason="Adjacent"/>
</robot>
